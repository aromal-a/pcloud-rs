# direnv config for pcloud-rs
# Loads .env automatically when you cd into this directory.
# Unloaded automatically on leaving.
#
# First-time setup:
#   1. pacman -S direnv
#   2. add `eval "$(direnv hook zsh)"` to ~/.zshrc and restart shell
#   3. run `direnv allow` from this directory (approves this .envrc)

# dotenv is a direnv stdlib helper; it reads .env KEY=value pairs and exports them.
dotenv_if_exists .env
