# pcloud-rs live-e2e credentials — TEMPLATE
# Copy to .env (which is gitignored) and fill in real values.
#
# Usage (bash):
#   set -a; source .env; set +a
#   cargo test -p pcloud-live-e2e -- --ignored

PCLOUD_LIVE=1
PCLOUD_LIVE_E2E=1

PCLOUD_USERNAME=you@example.com
PCLOUD_PASSWORD=replace-me

# Optional
# PCLOUD_TFA_CODE=
# PCLOUD_API_HOST=
# PCLOUD_FUSE_TEST=1
# PCLOUD_TEST_CRYPTO_PASSWORD=
