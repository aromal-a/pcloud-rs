# pcloud-rs live-e2e credentials — TEMPLATE (for local development / CI only)
#
# Copy to .env (gitignored) and fill in real values.
#
# SECURITY WARNING: Do NOT commit .env or source this file in a shell profile.
# Sourcing sets PCLOUD_PASSWORD in the shell environment, where it can be
# captured by shell history (e.g. `history`, `/proc/<pid>/environ`), crash
# dumps, `ps auxe`, and other process-enumeration tools.
#
# For production or headless deployments use PCLOUDRS_PASSWORD_FILE (a file
# path) instead of a raw password in the environment. See
# packaging/init/common/pcloudd.env.example for the production pattern.
#
# Usage (local tests only):
#   set -a; source .env; set +a
#   cargo test -p pcloud-live-e2e -- --ignored

PCLOUD_LIVE=1
PCLOUD_LIVE_E2E=1

# Non-secret test fixture:
PCLOUD_USERNAME=you@example.com

# WARNING: password in environment — development / CI use only.
# Do not use this pattern in production; use PCLOUDRS_PASSWORD_FILE instead.
PCLOUD_PASSWORD=replace-me

# Optional
# PCLOUD_TFA_CODE=
# PCLOUD_API_HOST=
# PCLOUD_FUSE_TEST=1
# PCLOUD_TEST_CRYPTO_PASSWORD=
