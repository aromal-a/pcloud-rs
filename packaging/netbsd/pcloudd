#!/bin/sh
# PLATFORM: NetBSD 10+
#
# rc.d service script for the pcloudd daemon (pkgsrc binary location).
#
# Install:
#   install -m 0555 packaging/netbsd/pcloudd /etc/rc.d/pcloudd
#   echo 'pcloudd=YES' >> /etc/rc.conf
#   /etc/rc.d/pcloudd start
#
# Inputs:
#   pcloudd (YES/NO) in /etc/rc.conf - master enable flag
#
# Outputs:
#   PID file at /var/run/pcloudd.pid
#
# Security:
#   - /var/run is created at boot but this script re-asserts it in
#     `pcloudd_precmd` in case /var/run was wiped.
#   - Run the daemon under a dedicated unprivileged account; use the
#     pkgsrc install framework (pkg_add) to provision it, or create
#     manually with useradd.
#
# Test:
#   /etc/rc.d/pcloudd onestart
#   /etc/rc.d/pcloudd status
#   /etc/rc.d/pcloudd stop
#
# Side effects: writes /var/run/pcloudd.pid on start, removes on stop.

# PROVIDE: pcloudd
# REQUIRE: DAEMON LOGIN
# KEYWORD: shutdown

$_rc_subr_loaded . /etc/rc.subr

name="pcloudd"
rcvar=$name
# The pcloudd binary does NOT accept -p / --pidfile.  rc.subr writes the
# pidfile itself via ${pidfile}; `serve` is required so pcloudd enters the
# IPC serve loop instead of printing a one-shot summary and exiting.
command="/usr/pkg/bin/pcloudd"
command_args="serve"
pidfile="/var/run/${name}.pid"
start_precmd="pcloudd_precmd"

pcloudd_precmd()
{
	if [ ! -d /var/run ]; then
		install -d -o root -g wheel -m 0755 /var/run
	fi
}

load_rc_config $name
run_rc_command "$1"
