<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimum entitlements for the pcloud-rs hardened runtime on macOS.

  Philosophy: request nothing we do not actually need. Every entitlement
  below weakens the hardened runtime somewhere; add with a code-review note.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for outbound HTTPS to the pCloud API. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Required: disables library validation so the hardened runtime will
         load the fuse-t or macFUSE dylib, which is signed by a different
         Team ID than ours. Without this the daemon cannot dlopen the FUSE
         library and every mount attempt fails with EPERM.
         Risk mitigated by: the dylib path is probed from canonical install
         locations only (not user-writable paths); the daemon runs as the
         user, not root; fuse-t is a notarised Apple-reviewed package. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Explicitly deny JIT, executable page allocation, and dyld env
         overrides. They are off by default under the hardened runtime;
         we pin them here so a future edit cannot silently enable one. -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>
</dict>
</plist>
