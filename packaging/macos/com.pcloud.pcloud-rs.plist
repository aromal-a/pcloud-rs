<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent for the pcloud-rs daemon (pcloudd).
  Install via: packaging/macos/install.sh
  The {{USER_HOME}} and {{BIN_DIR}} placeholders are substituted by install.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pcloud.pcloud-rs</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{BIN_DIR}}/pcloudd</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Avoid rapid restart loops: wait 10s before restarting on crash -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Kill child processes when launchd stops the job -->
    <key>AbandonProcessGroup</key>
    <false/>

    <!-- Interactive QoS: the daemon may mount a FUSE volume shown in Finder -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>{{USER_HOME}}/Library/Logs/pcloud-rs/pcloud-rs.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{USER_HOME}}/Library/Logs/pcloud-rs/pcloud-rs.err.log</string>

    <key>WorkingDirectory</key>
    <string>{{USER_HOME}}</string>

    <!-- Raise open-file limit for FUSE: each inode keeps a handle open -->
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PCLOUD_ROOT</key>
        <string>{{USER_HOME}}/.config/pcloud</string>
        <key>PCLOUD_ENV</key>
        <string>production</string>
        <key>PCLOUD_LOG_LEVEL</key>
        <string>info</string>
        <key>PCLOUD_API_HOST</key>
        <string>api.pcloud.com</string>
        <key>PCLOUD_API_SERVER_NAME</key>
        <string>api.pcloud.com</string>
        <key>PCLOUD_CONFIG</key>
        <string>{{USER_HOME}}/.config/pcloud/config.toml</string>
        <!-- Set to 1 to persist auth tokens to the macOS Keychain -->
        <key>PCLOUD_DURABLE_AUTH_TOKENS</key>
        <string>1</string>
        <!-- Set to an absolute path to auto-mount on daemon start -->
        <key>PCLOUD_AUTO_MOUNT_PATH</key>
        <string>{{USER_HOME}}/pCloudDrive</string>
    </dict>
    <!-- Optional: launchd socket activation for faster startup -->
    <!-- Uncomment to enable socket activation:
    <key>Sockets</key>
    <dict>
        <key>pcloud-ipc</key>
        <dict>
            <key>SockType</key>
            <string>Stream</string>
            <key>SockFamily</key>
            <string>Unix</string>
            <key>SockPathName</key>
            <string>{{USER_HOME}}/Library/Caches/com.pcloud.pcloud-rs/pcloud-rs-runtime/pcloud.sock</string>
        </dict>
    </dict>
    -->
</dict>
</plist>
