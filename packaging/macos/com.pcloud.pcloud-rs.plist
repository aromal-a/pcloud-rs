<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent for the pcloud-rs daemon (pcloudd).

  PLATFORM: macOS 11+.

  Install: use packaging/macos/install.sh — it substitutes {{USER_HOME}}
  and {{BIN_DIR}}, creates ~/Library/Logs/pcloud-rs, and loads the agent.

  Signing & notarization: see packaging/macos/README.md and
  packaging/signing/README.md. XML comments cannot contain command-line
  double-dash flags, so the concrete codesign/notarytool commands live in
  those Markdown files rather than in this plist template.

  Entitlements summary (see packaging/macos/entitlements.plist):
    com.apple.security.network.client          — outbound HTTPS to pCloud API
    com.apple.security.cs.disable-library-validation — true for fuse-t loading
    com.apple.security.cs.allow-jit            — false (pinned off)
    com.apple.security.cs.allow-unsigned-executable-memory — false (pinned off)
    com.apple.security.cs.allow-dyld-environment-variables — false (pinned off)

  Hardened-runtime note: do NOT add com.apple.security.cs.allow-jit or
  com.apple.security.cs.allow-unsigned-executable-memory unless a future
  dependency genuinely requires them; both are high-value sandbox escapes.

  Per-directive notes:
    - ProcessType=Interactive: the daemon may mount a FUSE volume shown
      in Finder, so launchd gives it a user-interactive QoS.
    - KeepAlive.SuccessfulExit=false + Crashed=true: respawn on crash
      but not on clean shutdown (e.g. `launchctl unload`).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pcloud.pcloud-rs</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{BIN_DIR}}/pcloudd</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>ExitTimeOut</key>
    <integer>30</integer>

    <!-- Avoid rapid restart loops: wait 10 seconds before restarting on crash. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Kill child processes when launchd stops the job -->
    <key>AbandonProcessGroup</key>
    <false/>

    <!-- Interactive QoS: the daemon may mount a FUSE volume shown in Finder -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>{{USER_HOME}}/Library/Logs/pcloud-rs/pcloud-rs.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{USER_HOME}}/Library/Logs/pcloud-rs/pcloud-rs.err.log</string>

    <key>WorkingDirectory</key>
    <string>{{USER_HOME}}</string>

    <!-- Raise open-file limit for FUSE: each inode keeps a handle open -->
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PCLOUD_ROOT</key>
        <string>{{USER_HOME}}/.config/pcloud-rs</string>
        <key>PCLOUD_ENV</key>
        <string>production</string>
        <key>PCLOUD_LOG_LEVEL</key>
        <string>info</string>
        <!-- Set to 1 to persist auth tokens to the macOS Keychain -->
        <key>PCLOUD_DURABLE_AUTH_TOKENS</key>
        <string>1</string>
        <!-- Set to an absolute path to auto-mount on daemon start -->
        <key>PCLOUD_AUTO_MOUNT_PATH</key>
        <string>{{USER_HOME}}/pCloudDrive</string>
    </dict>
    <!-- Optional: launchd socket activation for faster startup -->
    <!-- Uncomment to enable socket activation:
    <key>Sockets</key>
    <dict>
        <key>pcloud-ipc</key>
        <dict>
            <key>SockType</key>
            <string>Stream</string>
            <key>SockFamily</key>
            <string>Unix</string>
            <key>SockPathName</key>
            <string>{{USER_HOME}}/Library/Caches/com.pcloud.pcloud-rs/pcloud-rs-runtime/pcloud.sock</string>
        </dict>
    </dict>
    -->
</dict>
</plist>
