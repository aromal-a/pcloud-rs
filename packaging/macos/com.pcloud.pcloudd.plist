<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  System LaunchDaemon for the pcloudd background service.

  PLATFORM: macOS 11+ (Big Sur and later; hardened-runtime era).

  Install:
    sudo cp com.pcloud.pcloudd.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/com.pcloud.pcloudd.plist
    sudo chmod 644      /Library/LaunchDaemons/com.pcloud.pcloudd.plist
    sudo launchctl load -w /Library/LaunchDaemons/com.pcloud.pcloudd.plist

  LaunchDaemons run as root by default. The UserName/GroupName keys
  below drop privileges to a dedicated service account; create it with:
    sudo dscl . -create /Users/_pcloudd UniqueID 299
    sudo dscl . -create /Users/_pcloudd PrimaryGroupID 299
    sudo dscl . -create /Users/_pcloudd UserShell /usr/bin/false
    sudo dscl . -create /Users/_pcloudd NFSHomeDirectory /var/lib/pcloudd

  Environment-variable accuracy (cross-checked against
  crates/pcloud-config/src/env.rs and pcloud-daemon):
    - PCLOUD_ROOT / PCLOUD_ENV / PCLOUD_LOG_LEVEL are **read** by the daemon.
    - PCLOUD_HOME, PCLOUD_CONFIG, PCLOUD_AUTH_VAULT, PCLOUD_IPC_SOCKET,
      PCLOUD_API_SERVER, PCLOUD_API_HOST, and PCLOUD_API_SERVER_NAME are NOT
      exported by this plist. The Rust daemon derives all paths from
      PCLOUD_ROOT and uses the binary API default endpoint unless an operator
      intentionally overrides it in a separate config file.

  Per-directive notes (load-bearing launchd keys):
    - Label              — launchd identifier; must match the plist filename stem.
    - ProgramArguments   — argv[] for the service; argv[0] is the absolute binary path.
    - RunAtLoad          — start at system boot and after load (true).
    - KeepAlive          — restart policy; we only restart on crash, not on clean exit.
    - UserName/GroupName — drop privileges to the dedicated service account.
    - ProcessType=Background — lower QoS; launchd budgets CPU/IO accordingly.
    - StandardOutPath/StandardErrorPath — stdout/stderr redirection (newline-buffered).
    - WorkingDirectory   — daemon's cwd; also its state root.
    - EnvironmentVariables — exported into the daemon process env. See accuracy note above.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pcloud.pcloudd</string>

    <!-- argv[0] is the daemon binary; `serve` selects the long-running IPC
         serve loop (matches ExecStart in packaging/systemd/pcloudd.service).
         Without `serve`, the daemon prints a one-shot runtime summary and
         exits, which launchd would then restart in a loop via KeepAlive.
         The non-existent double-dash system flag was removed in audit-06 (bd
         pcloud-rs-ncx.25): the daemon parser at crates/pcloud-daemon/src/
         main.rs:56-64 rejects unknown args, so the plist previously caused
         an immediate launchd crash-loop. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/pcloudd</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Allow the daemon 30 s to drain in-flight IPC work before launchd
         sends SIGKILL. Matches TimeoutStopSec=30s in the systemd unit. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <!-- Prevent a crash-loop from hammering the system: launchd will not
         restart the daemon more than once every 10 seconds. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>UserName</key>
    <string>_pcloudd</string>
    <key>GroupName</key>
    <string>_pcloudd</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/var/log/pcloudd/pcloudd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/pcloudd/pcloudd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/var/lib/pcloudd</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Read by the Rust daemon: -->
        <key>PCLOUD_ROOT</key>
        <string>/var/lib/pcloudd</string>
        <key>PCLOUD_ENV</key>
        <string>production</string>
        <key>PCLOUD_LOG_LEVEL</key>
        <string>info</string>
        <!-- PCLOUD_HOME, PCLOUD_CONFIG, PCLOUD_AUTH_VAULT, PCLOUD_API_SERVER,
             PCLOUD_API_HOST, PCLOUD_API_SERVER_NAME, and PCLOUD_IPC_SOCKET
             removed: the Rust daemon derives all paths from PCLOUD_ROOT and
             uses the secure binary API endpoint by default. Removed to avoid
             mandatory-missing config files and endpoint drift. -->
    </dict>
</dict>
</plist>
