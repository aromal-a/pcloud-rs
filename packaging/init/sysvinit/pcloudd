#!/bin/sh
### BEGIN INIT INFO
# Provides:          pcloudd
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: pCloud Rust daemon
### END INIT INFO

NAME=pcloudd
DESC="pCloud Rust daemon"
PIDFILE=/var/run/${NAME}.pid
DAEMON_USER=${DAEMON_USER:-pcloud-rs}
ENVFILE=/etc/default/pcloudd
WRAPPER=/usr/local/libexec/pcloudd-wrapper.sh

[ -r "${ENVFILE}" ] && . "${ENVFILE}"

start() {
    echo "Starting ${DESC}"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --start --background --make-pidfile --pidfile "${PIDFILE}" \
            --chuid "${DAEMON_USER}" --exec "${WRAPPER}" --
    else
        su -s /bin/sh -c "nohup ${WRAPPER} >/dev/null 2>&1 & echo \\$! > '${PIDFILE}'" "${DAEMON_USER}"
    fi
}

stop() {
    echo "Stopping ${DESC}"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --stop --pidfile "${PIDFILE}" --retry 10
    elif [ -f "${PIDFILE}" ]; then
        kill "$(cat "${PIDFILE}")" 2>/dev/null || true
    fi
    rm -f "${PIDFILE}"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status)
    if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
      echo "${NAME} is running"
      exit 0
    fi
    echo "${NAME} is not running"
    exit 3
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
