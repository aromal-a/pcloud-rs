# pcloud-rs daemon service environment
#
# Copy to one of:
#   /etc/default/pcloudd      (Linux/systemd/sysv/openrc)
#   /etc/conf.d/pcloudd       (OpenRC)
#   /usr/local/etc/pcloudd.env (BSD rc.d examples)
#
# Keep this file mode 0600 or stricter.

# Where the daemon stores sqlite, vault, runtime sockets, cache.
PCLOUD_ROOT=/var/lib/pcloud-rs

# Secure production defaults.
PCLOUD_ENV=production
PCLOUD_API_MODE=tls

# Optional: persist the auth token in the daemon vault after a successful
# bootstrap. The vault stores the auth token, never the account password.
PCLOUD_DURABLE_AUTH_TOKENS=1

# Preferred: provide a long-lived auth token file.
PCLOUDRS_TOKEN_FILE=/etc/pcloud-rs/credentials/token

# First-boot fallback: username/password from files.
# Leave these unset when using PCLOUDRS_TOKEN_FILE.
#PCLOUDRS_USERNAME_FILE=/etc/pcloud-rs/credentials/username
#PCLOUDRS_PASSWORD_FILE=/etc/pcloud-rs/credentials/password

# Optional second factor for service bootstrap when the account requires it.
# Set exactly one of these when bootstrapping with username/password.
#PCLOUDRS_TFA_CODE_FILE=/etc/pcloud-rs/credentials/tfa-code
#PCLOUDRS_RECOVERY_CODE_FILE=/etc/pcloud-rs/credentials/recovery-code

# Optional: trust this device after a successful TFA login.
#PCLOUDRS_TRUST_DEVICE=1

# Optional binary override.
#PCLOUDRS_DAEMON_BIN=/usr/local/bin/pcloudd
