#!/bin/ksh
# PLATFORM: OpenBSD 7.x

daemon="/usr/bin/env PCLOUDRS_DAEMON_BIN=/usr/local/bin/pcloudd PCLOUDRS_ENV_FILE=/usr/local/etc/pcloud-rs/pcloudd.env /usr/local/libexec/pcloudd-wrapper.sh"
daemon_flags=""
daemon_user="_pcloud"

. /etc/rc.d/rc.subr

# pcloudd is intentionally foreground-only. rc_bg is the documented OpenBSD
# rc.d mechanism for starting such a service without blocking the boot.
rc_bg=YES
pexp="/usr/local/bin/pcloudd serve"

rc_pre()
{
    if ! id "${daemon_user}" >/dev/null 2>&1; then
        echo "pcloudd: service user does not exist: ${daemon_user}" >&2
        return 1
    fi
    install -d -o "${daemon_user}" -g "${daemon_user}" -m 0700 \
        /var/lib/pcloud-rs
}

rc_cmd "$1"
