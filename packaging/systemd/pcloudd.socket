[Unit]
Description=pCloud Console Client daemon IPC socket
Documentation=https://github.com/ezechiel203/pcloud-rs

[Socket]
# Owner-only local IPC. This unit is kept as a future socket-activation
# template only: the current daemon does not consume LISTEN_FDS and the
# service binds its own socket. Do not enable this unit until that support
# lands, or systemd will create a listener the daemon never accepts from.
#
# Path matches pcloudd.service's PCLOUD_ROOT=%S/pcloud-rs default:
# ConfigProfile::secure_defaults(root).paths.ipc_socket_path().
ListenStream=%S/pcloud-rs/runtime/pcloud.sock
SocketMode=0600
DirectoryMode=0700
# Do not set SocketUser/SocketGroup to a shared group — owner-only by design.
RemoveOnStop=yes
PassCredentials=yes
PassSecurity=yes

# Reject connection storms before they reach the daemon.
Accept=no
Backlog=16
MaxConnections=32
MaxConnectionsPerSource=8

# No world/group access anywhere, at any time.
# (Intentionally NO SmackLabelIPIn/Out to avoid accidental relaxation.)

# No [Install] section intentionally: socket activation is not wired yet.
