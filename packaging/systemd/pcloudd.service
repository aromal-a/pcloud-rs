[Unit]
Description=pCloud Console Client (Rust daemon)
Documentation=https://github.com/ezechiel203/pcloud-rs
After=network-online.target
Wants=network-online.target

# This unit is system-scoped only:
#   sudo systemctl enable --now pcloudd.service
# It uses DynamicUser=yes, StateDirectory=, LogsDirectory=, and other
# directives that are invalid or ineffective in `systemctl --user` units.
# Use packaging/systemd/pcloudd-user.service for per-user deployments.
#
# This unit uses Type=simple because the Unix `pcloudd serve` path binds its
# own IPC socket and enters the serve loop directly; it does not emit READY=1
# during that startup path. WATCHDOG=1 notifications are still accepted below
# for loop-progress monitoring. Socket activation (pcloudd.socket) is
# intentionally NOT required until the daemon implements LISTEN_FDS support.
# Graceful shutdown is handled by the daemon's SIGTERM/SIGINT handlers, which
# flip an internal shutdown flag that lets the IPC serve loop drain in-flight
# work and exit cleanly within TimeoutStopSec.
#
# ---
# FUSE DEPLOYMENTS: this shipped unit intentionally BLOCKS /dev/fuse and the
# @mount syscall group (see `PrivateDevices=yes` and the `@mount` entry in
# `SystemCallFilter=` below). Deployments that mount a pCloud filesystem
# through this daemon MUST install the `override-fuse.conf.example` drop-in
# that lifts both restrictions. See `packaging/systemd/README.md` for the
# installation walkthrough and the security trade-offs involved.
# ---

[Service]
Type=simple
# WatchdogSec is intentionally unset until the daemon derives its accept-loop
# timeout from $WATCHDOG_USEC and emits heartbeats faster than half the
# configured watchdog interval. Keeping WatchdogSec=30s here can restart a
# healthy idle daemon.
ExecStart=/usr/bin/pcloudd serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# systemd sends SIGTERM on stop by default; the daemon's signal handler
# translates that into a graceful IPC-level shutdown. SIGKILL is only used
# if the daemon exceeds TimeoutStopSec.
KillMode=mixed
KillSignal=SIGTERM

# --- Identity ---
# System-mode: use an ephemeral, unprivileged user. Comment out for --user units.
DynamicUser=yes
# User=pcloud-rs
# Group=pcloud-rs

# --- Filesystem isolation ---
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
UMask=0077

# Only the runtime directory (auth vault, sqlite, sockets) is writable.
RuntimeDirectory=pcloud-rs
RuntimeDirectoryMode=0700
StateDirectory=pcloud-rs
StateDirectoryMode=0700
LogsDirectory=pcloud-rs
LogsDirectoryMode=0700
#
# --- ReadWritePaths vs StateDirectory/LogsDirectory (audit-06 H-2 / bd-pcloud-rs-ncx.77) ---
#
# Under `ProtectSystem=strict`, the filesystem is read-only by default.
# The three `*Directory=` directives above already grant the service
# write access to the matching paths under `DynamicUser=yes`:
#
#   StateDirectory=pcloud-rs   -> /var/lib/pcloud-rs    (rw)
#   LogsDirectory=pcloud-rs    -> /var/log/pcloud-rs    (rw)
#   RuntimeDirectory=pcloud-rs -> /run/pcloud-rs        (rw, tmpfs)
#
# The `ReadWritePaths=` line below is therefore REDUNDANT in the default
# `DynamicUser=yes` configuration: systemd already opens those exact
# paths read-write when DynamicUser is active.
#
# It is kept ONLY as a safety net for operators who flip `User=`/`Group=`
# (see the Identity block above) AND remove `DynamicUser=yes`. Under a
# fixed-user deployment, `StateDirectory=` still creates the directory
# but its write-access grant only applies when the service's effective
# UID owns the directory. Operators replacing `DynamicUser=yes` with
# `User=pcloud-rs` must:
#
#   1. `chown pcloud-rs:pcloud-rs /var/lib/pcloud-rs /var/log/pcloud-rs`
#      so the fixed user can write to those paths, AND
#   2. keep `ReadWritePaths=` as below so ProtectSystem=strict does not
#      veto the write even after the chown.
#
# See `packaging/systemd/override.conf.example` for a drop-in that flips
# to a fixed user and reconciles ownership.
ReadWritePaths=/var/lib/pcloud-rs /var/log/pcloud-rs
# No other writable paths. FUSE mount (if enabled) should be declared per-deployment.

# --- Privilege reduction ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes

# --- Network ---
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# IPAddressDeny / IPAddressAllow are intentionally NOT set in the
# default unit. Earlier revisions shipped `IPAddressDeny=any` paired
# with `IPAddressAllow=localhost` here, which silently broke a
# default install — every API call to *.pcloud.com was dropped at
# the cgroup before it left the host. Operators who want a strict
# egress allow-list should drop in
# `packaging/systemd/override.conf.example`, which re-enables
# `IPAddressDeny=any` and lists the published pCloud API CIDRs.
# Default behaviour: route via the host firewall, not the unit.
# Audit reference: CLAUDEREV/00-executive-summary.md DEPLOY-H-11.3.

# --- Syscall filter (deny-by-default allowlist) ---
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @cpu-emulation @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

# --- Resource limits ---
MemoryMax=512M
MemoryHigh=384M
CPUQuota=75%
TasksMax=256
LimitNOFILE=4096
LimitNPROC=256
LimitCORE=0

# --- Misc hardening ---
KeyringMode=private
RestrictNamespaces=yes
RestrictRealtime=yes

# --- Environment defaults ---
# PCLOUD_ROOT sets the daemon's working root for config/state/runtime/cache.
# Anchor it to systemd's managed persistent state directory so DynamicUser=yes,
# ProtectSystem=strict, and ProtectHome=tmpfs do not leave discovery dependent
# on an inaccessible home directory.
Environment=PCLOUD_ROOT=%S/pcloud-rs

# --- Credentials (operator responsibility) ---
# Provide secrets via systemd-creds. NEVER via Environment=.
# To provision:
#   systemd-creds encrypt --name=pcloud-rs-token /path/to/plain.token \
#       /etc/credstore.encrypted/pcloud-rs-token
# Then uncomment:
#LoadCredentialEncrypted=pcloud-rs-token:/etc/credstore.encrypted/pcloud-rs-token
# The daemon reads $CREDENTIALS_DIRECTORY/pcloud-rs-token if present.

[Install]
WantedBy=multi-user.target
