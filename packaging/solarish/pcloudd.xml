<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<service_bundle type="manifest" name="pcloud-rs">
  <service name="site/pcloud-rs" type="service" version="1">
    <create_default_instance enabled="false"/>
    <single_instance/>

    <dependency
      name="multi-user"
      grouping="require_all"
      restart_on="none"
      type="service">
      <service_fmri value="svc:/milestone/multi-user:default"/>
    </dependency>

    <method_context working_directory="/var/lib/pcloud-rs">
      <method_credential user="pcloudd" group="pcloudd"/>
    </method_context>

    <exec_method
      type="method"
      name="start"
      exec="/lib/svc/method/pcloudd start"
      timeout_seconds="0"/>
    <exec_method
      type="method"
      name="stop"
      exec=":kill"
      timeout_seconds="60"/>
    <exec_method
      type="method"
      name="refresh"
      exec=":kill -HUP"
      timeout_seconds="60"/>

    <property_group name="startd" type="framework">
      <propval name="duration" type="astring" value="child"/>
    </property_group>

    <stability value="Evolving"/>

    <template>
      <common_name>
        <loctext xml:lang="C">pcloud-rs daemon</loctext>
      </common_name>
      <description>
        <loctext xml:lang="C">
          Local pCloud API, transfer, synchronization, and CLI service
        </loctext>
      </description>
      <documentation>
        <doc_link name="pcloud-rs documentation"
          uri="https://github.com/pcloudcom/pcloud-rs"/>
      </documentation>
    </template>
  </service>
</service_bundle>
