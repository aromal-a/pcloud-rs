#!/bin/sh
# PLATFORM: FreeBSD 13+
#
# rc.d service script for the pcloudd daemon.
#
# Install:
#   install -m 0555 packaging/freebsd/pcloudd.rc /usr/local/etc/rc.d/pcloudd
#   sysrc pcloudd_enable="YES"
#   sysrc pcloudd_user="pcloud"         # optional; default below
#   service pcloudd start
#
# Inputs (from /etc/rc.conf or rc.conf.local):
#   pcloudd_enable   (YES/NO)   - master enable flag; default "NO"
#   pcloudd_user     (string)   - run-as user; default "pcloudd"
#   pcloudd_flags    (string)   - extra CLI flags passed to pcloudd
#
# Outputs:
#   PID tracking is handled by rc.subr via pidfile= (set below).
#   The daemon binary does NOT accept a -p/--pidfile flag; rc.subr
#   monitors the process directly via ${pidfile}.
#   Logs go to syslog via the daemon's internal logger.
#
# Security:
#   - The script assumes a dedicated `pcloudd` user exists. Create with:
#       pw useradd pcloudd -c 'pcloudd service' -d /nonexistent \
#                          -s /usr/sbin/nologin -h -
#   - The daemon's state root should be chowned to that user: 0700 perms.
#   - rc.subr drops privileges before exec via the pcloudd_user variable.
#
# Test:
#   service pcloudd onestart     # ignore rc.conf enable flag
#   service pcloudd status
#   service pcloudd stop
#
# Side effects: rc.subr creates /var/run/pcloudd.pid; on stop, rc.subr removes it.

# PROVIDE: pcloudd
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="pcloudd"
rcvar="pcloudd_enable"

load_rc_config $name

: ${pcloudd_enable:="NO"}
: ${pcloudd_user:="pcloudd"}
: ${pcloudd_flags:=""}

command="/usr/local/bin/pcloudd"
# rc.subr tracks the PID via this file; pcloudd does not write it itself.
# Do NOT pass -p to pcloudd — that flag does not exist on the Rust binary.
# `serve` is required: without it pcloudd prints a one-shot summary and exits.
pidfile="/var/run/${name}.pid"
command_args="serve"

start_precmd()
{
    kldload -n fusefs 2>/dev/null || true
    # Ensure the pid-file directory exists and is writable by the daemon user.
    # rc.subr writes ${pidfile} = /var/run/${name}.pid, which lives directly in
    # /var/run/ (always present on FreeBSD). If you change pidfile to a
    # subdirectory (e.g. /var/run/pcloudd/pcloudd.pid), create the directory
    # here with install -d -o ${pcloudd_user} -m 0755.
    : # /var/run is always present; no subdirectory needed for the default pidfile path
}

pcloudd_precmd="start_precmd"

run_rc_command "$1"
