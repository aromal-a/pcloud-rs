<?xml version="1.0" encoding="UTF-8"?>
<!--
  PLATFORM: Windows 10/11
  pcloud-rs WiX installer source.

  Signing: the MSI MUST be Authenticode-signed before public distribution.
  Signing is performed in the release CI workflow (.github/workflows/release.yml)
  using a secret-store certificate; it is intentionally NOT part of the
  build-from-source path.

  CI GUARD: unsigned MSIs must not be published. The release workflow must
  verify the signature with:
    signtool verify /pa /v dist\pcloud-rs-*.msi
  and fail the job if the exit code is non-zero.

  UpgradeCode: frozen at {A3F7E21C-8B4D-4F6A-9C2E-1D5B3A8F07E9}.
  DO NOT change this GUID — Windows Installer uses it to identify the product
  family across all past and future versions. Changing it breaks upgrade and
  uninstall paths for every existing installation.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="pcloud-rs"
           Language="1033"
           Version="!(bind.FileVersion.PcloudDaemonExe)"
           Manufacturer="pcloud-rs contributors"
           UpgradeCode="{A3F7E21C-8B4D-4F6A-9C2E-1D5B3A8F07E9}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="pcloud-rs command-line pCloud client"
             Manufacturer="pcloud-rs contributors" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of pcloud-rs is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- WinFSP is required for the mounted-drive / FUSE-equivalent feature. -->
    <PackageDependency Id="winfsp" />

    <Icon Id="pcloud-rs.ico" SourceFile="pcloud-rs.ico" />
    <Property Id="ARPPRODUCTICON" Value="pcloud-rs.ico" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="pcloud-rs">

          <Component Id="PcloudDaemonExe" Guid="*" Win64="yes">
            <File Id="PcloudDaemonExe"
                  Name="pcloudd.exe"
                  Source="$(var.StageDir)\pcloudd.exe"
                  KeyPath="yes" />
          </Component>

          <Component Id="PcloudCliExe" Guid="*" Win64="yes">
            <File Id="PcloudCliExe"
                  Name="pcloudc.exe"
                  Source="$(var.StageDir)\pcloudc.exe"
                  KeyPath="yes" />
          </Component>

          <!--
            Windows Service wrapper.
            launchd plist analog on Windows = ServiceInstall + ServiceControl.
          -->
          <Component Id="PcloudSvcExe" Guid="*" Win64="yes">
            <File Id="PcloudSvcExe"
                  Name="pcloudd-svc.exe"
                  Source="$(var.StageDir)\pcloudd-svc.exe"
                  KeyPath="yes" />
            <!--
              Security: run as the virtual service account "NT SERVICE\pcloudd"
              instead of LocalSystem. Virtual service accounts have minimal
              privileges (no network logon, no admin rights) and do not require
              a password. LocalSystem is intentionally NOT used because it has
              unrestricted local access and is a common privilege-escalation
              target.
            -->
            <ServiceInstall Id="PcloudSvcInstall"
                            Name="pcloudd"
                            DisplayName="pcloud-rs daemon"
                            Description="pCloud sync daemon (Rust)"
                            Type="ownProcess"
                            Start="auto"
                            Account="NT SERVICE\pcloudd"
                            ErrorControl="normal"
                            Vital="yes" />
            <ServiceControl Id="PcloudSvcControl"
                            Name="pcloudd"
                            Start="install"
                            Stop="both"
                            Remove="uninstall"
                            Wait="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppProgramMenuDir" Name="pcloud-rs">
          <Component Id="StartMenuShortcut" Guid="*">
            <Shortcut Id="PcloudCliShortcut"
                      Name="pcloud-rs CLI"
                      Target="[INSTALLFOLDER]pcloudc.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveAppProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\pcloud-rs"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="pcloud-rs" Level="1">
      <ComponentRef Id="PcloudDaemonExe" />
      <ComponentRef Id="PcloudCliExe" />
      <ComponentRef Id="PcloudSvcExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
