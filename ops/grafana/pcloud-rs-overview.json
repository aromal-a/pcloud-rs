{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping pcloudd /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "pcloud-rs daemon overview — auth attempts, request latency, transfer bytes, crypto state, IPC clients, panics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Auth Attempts Rate",
      "description": "Rate of auth attempts by result label. Spike or sustained failure rate triggers PcloudAuthAttemptSpike / PcloudHighAuthFailureRate.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(pcloud_auth_attempts_total[2m])",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 2,
      "title": "Request Latency p50 / p99",
      "description": "IPC request latency percentiles. p99 > 5 s triggers PcloudHighRequestLatency.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(pcloud_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p50 {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(pcloud_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p99 {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 3,
      "title": "Transfer Bytes Rate",
      "description": "Bytes transferred per second by direction (upload / download). Flat line with sync roots active triggers PcloudTransferStale.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(pcloud_transfer_bytes_total[2m])",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "id": 4,
      "title": "Crypto Lock State",
      "description": "-1 = unsetup, 0 = locked, 1 = unlocked. Value 0 with sync roots active triggers PcloudCryptoUnexpectedlyLocked.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "pcloud_crypto_lock_state",
          "legendFormat": "crypto state",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": { "text": "UNSETUP", "color": "blue" },
                "0":  { "text": "LOCKED",  "color": "red"  },
                "1":  { "text": "UNLOCKED","color": "green"}
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "IPC Connected Clients",
      "description": "Currently connected IPC peers. Cap is 128; reaching it triggers PcloudIpcClientsExhausted.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "pcloud_ipc_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 64   },
              { "color": "red",    "value": 120  }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Panic Count",
      "description": "Lifetime panic counter. Any value > 0 triggers PcloudPanicDetected (critical).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "pcloud_panic_count",
          "legendFormat": "panics",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["pcloud-rs", "daemon", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "pcloud-rs Daemon Overview",
  "uid": "pcloud-rs-overview",
  "version": 2
}
